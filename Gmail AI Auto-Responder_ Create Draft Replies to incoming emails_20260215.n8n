      "id": "45dd1095-6573-4398-8e83-b5c6781ca078",
      "name": "Gmail trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "position": [
        -272,
        864
      ],
      "typeVersion": 1.2,
