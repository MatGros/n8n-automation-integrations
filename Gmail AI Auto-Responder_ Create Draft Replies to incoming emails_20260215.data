          "jsonSchema": "={\n  \"type\": \"object\",\n  \"properties\": {\n    \"needsReply\": {\n      \"type\": \"boolean\"\n    },\n    \"replyReason\": {\n      \"type\": \"string\",\n      \"description\": \"Explanation of why a reply is needed or not\"\n    },\n    \"id\": {\n      \"type\": \"string\",\n      \"id\": \"Mail ID\"\n    }\n  },\n  \"required\": [\"needsReply\"]\n}",
