# n8n Workflows - Environment Configuration Template
# Copy this file to .env and fill in your own values
# NEVER commit .env to version control

# ============================================================================
# n8n Instance Configuration
# ============================================================================
N8N_HOST=https://your-n8n-instance.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
N8N_API_KEY=your_api_key_here
N8N_WEBHOOK_HOST=https://your-webhook-domain.com

# Encryption Key (generate with: openssl rand -base64 32)
N8N_ENCRYPTION_KEY=your_encryption_key_here

# ============================================================================
# Communication Workflows Credentials
# ============================================================================

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_NAME=your_bot_name

# Email Configuration (Gmail)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Slack
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ============================================================================
# Marketing Workflows Credentials
# ============================================================================

# Twitter/X API (v2)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Facebook / Instagram
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# ============================================================================
# AI / LLM Services
# ============================================================================

# OpenAI API
OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Cloud & Infrastructure Services
# ============================================================================

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# Notion API
NOTION_API_KEY=your_notion_api_key_here

# MongoDB (if using as external database)
MONGO_URL=mongodb://localhost:27017/n8n

# Redis (optional, for improved performance)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ============================================================================
# Database Configuration
# ============================================================================

DB_TYPE=postgresql
DB_POSTGRESQL_HOST=localhost
DB_POSTGRESQL_PORT=5432
DB_POSTGRESQL_DATABASE=n8n
DB_POSTGRESQL_USER=n8n
DB_POSTGRESQL_PASSWORD=your_database_password_here

# Or SQLite for development (default)
# DB_TYPE=sqlite
# DB_SQLITE_PATH=./n8n.db

# ============================================================================
# Logging & Debugging
# ============================================================================

DEBUG=false
LOG_LEVEL=info
NODE_ENV=development

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
# 1. Never commit this file with actual values to version control
# 2. Always use strong, random passwords and API keys
# 3. Rotate credentials regularly (monthly recommended)
# 4. Use environment-specific .env files (.env.local, .env.production)
# 5. Store sensitive values in a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# 6. For production, use HTTPS (N8N_PROTOCOL=https)
# 7. Enable 2FA and SSO where available
# 8. Limit API key permissions to required scopes only
# 9. Monitor credential usage and audit logs
# 10. See docs/security-best-practices.md for detailed security guidance
